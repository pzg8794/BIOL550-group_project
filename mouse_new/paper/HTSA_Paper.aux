\@writefile{toc}{\contentsline {section}{\numberline {3}Results}{8}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Quality Control and Trimming of RNASeq Data}{8}{subsection.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Adapter content present in the RNA-seq samples before trimming (A) and after trimming (B). The pre-trim panel shows strong adapter-associated signal near the read end, whereas the post-trim panel shows that this signal was largely removed.}}{8}{figure.caption.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Alignment statistics after mapping the trimmed reads to the GRCm39 \textit  {Mus musculus} reference genome. Panel A shows uniquely mapped percentages for each sample, and Panel B shows the distribution of uniquely mapped reads across the full subset.}}{9}{figure.caption.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Differential Expression Analysis}{10}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Principal Component Analysis (PCA) of DRG transcriptomes. Samples are plotted along the first two principal components, which capture 46.2\% and 20.6\% of the variance, respectively. Shapes represent injury side and colors represent genotype.}}{10}{figure.caption.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Sample-to-sample distance heatmap of DRG transcriptomes. Euclidean distances were calculated from regularized log-transformed counts. Darker blue indicates higher similarity, and lighter blue indicates lower similarity.}}{11}{figure.caption.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Comparison of volcano plots for the \texttt  {ipsi\_vs\_contra\_in\_ff} contrast. Panel A shows the full significant set, and Panel B highlights the genes retained at the bend-point threshold.}}{12}{figure.caption.7}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Gene Ontology Analysis}{13}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Gene Ontology (GO) analysis of the 709-gene \texttt  {ipsi\_vs\_contra\_in\_ff} follow-up set. Biological Process, Cellular Component, and Molecular Function results are shown through lollipop plots and network views.}}{14}{figure.caption.8}\protected@file@percent }
